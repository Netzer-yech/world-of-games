# Files and folders git must never track

# Python bytecode cache, auto-generated on every run
__pycache__/

# Compiled Python files (* = any name)
*.pyc

# Virtual env: local packages, rebuilt from requirements.txt
.venv/

# Local secrets (API keys); never push them to GitHub
.env

# pytest's cache of the last run, local only
.pytest_cache/

# The real score, created by the game on the first win: data, not code
/Scores.txt

# A leftover copy if a save was interrupted
/Scores.txt.tmp
